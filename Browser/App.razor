@using DoomSharp
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS

<h1>DoomSharp</h1>
<p>The same C# engine, running locally in WebAssembly. Incomplete DOOM compatibility.</p>
<p>Choose a runtime: <strong>.NET WASM (Blazor AOT)</strong> · <a href="netwasm/">NetWasm</a>.
The two versions share the C# game engine and bundled Freedoom assets.</p>
<div class="controls">
    <button @onclick="LoadFreedoom" disabled="@loading">Restart Freedoom</button>
    <label>Local WAD <InputFile OnChange="LoadFile" accept=".wad" disabled="@loading" /></label>
    <label>Map <input @bind="map" aria-label="Map" size="8" /></label>
    <label><input type="checkbox" checked="@muted" @onchange="ToggleMute" /> Mute</label>
    <button @onclick="TriggerSave" disabled="@loading">Save Game</button>
    <button @onclick="TriggerLoad" disabled="@loading">Load Game</button>
    <button @onclick="RunBenchmark" disabled="@loading">Benchmark 120 renders</button>
</div>
<p id="status" role="status">@status</p>
<canvas id="game" width="640" height="400" tabindex="0" aria-label="DoomSharp game"></canvas>
<p>Freedoom starts automatically without sound. Click the game to enable sound and capture the mouse. WASD moves, arrows turn,
Ctrl/click fires, E/Space uses, Shift runs, 1/2/4/5 selects weapons, Tab maps,
R restarts, F1 opens the menu, F5/Save Game saves, F9/Load Game loads. Esc releases the pointer and pauses. Click to resume.</p>
<p>Local WADs stay on your device (64 MiB limit). Map defaults to the first map.
No proprietary assets included. <a href="assets/freedoom/COPYING.txt">Freedoom license</a>,
<a href="assets/freedoom/CREDITS.txt">credits</a>,
<a href="assets/freedoom/CREDITS-MUSIC.txt">music credits</a>.</p>

@code {
    readonly Renderer renderer = new();
    readonly Renderer benchmarkRenderer = new();
    readonly Input input = new();
    readonly Queue<(Buttons Button, bool Down)> inputEvents = new();
    readonly byte[] rgba = new byte[640 * 400 * 4];
    readonly List<byte[]> sounds = [];
    readonly Dictionary<string, byte[]?> soundCache = new(StringComparer.Ordinal);
    readonly Dictionary<string, byte[]?> musicCache = new(StringComparer.Ordinal);
    bool musicChanged;
    string? musicLumpName;
    Game? game;
    Game? benchmarkGame;
    IJSObjectReference? host;
    DotNetObjectReference<App>? reference;
    string status = "Loading Freedoom...", map = "";
    bool loading = true;
    bool muted { get; set; }
    double previous = -1, accumulator;
    string? audioError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        host = await JS.InvokeAsync<IJSObjectReference>("import", "./host.js");
        reference = DotNetObjectReference.Create(this);
        await host.InvokeVoidAsync("initialize", reference);
        await LoadFreedoom();
        StateHasChanged();
    }

    async Task LoadFreedoom()
    {
        await LoadWad(() => Http.GetByteArrayAsync("assets/freedoom/freedoom1.wad"));
    }

    async Task LoadFile(InputFileChangeEventArgs e)
    {
        await LoadWad(async () =>
        {
            using var source = e.File.OpenReadStream(64 * 1024 * 1024);
            using var destination = new MemoryStream();
            await source.CopyToAsync(destination);
            return destination.ToArray();
        });
    }

    async Task LoadWad(Func<Task<byte[]>> read)
    {
        loading = true;
        status = "Loading WAD...";
        StateHasChanged();
        game = null;
        benchmarkGame = null;
        Array.Clear(rgba);
        sounds.Clear(); soundCache.Clear(); musicCache.Clear();
        musicChanged = false; musicLumpName = null;
        ResetInput();
        try
        {
            Wad wad = new(await read());
            string selected = string.IsNullOrWhiteSpace(map) ?
                wad.Maps.FirstOrDefault() ?? throw new InvalidDataException("WAD contains no classic maps.") :
                map.Trim().ToUpperInvariant();
            game = new(wad, selected);
            benchmarkGame = new(wad, selected);
            game.PlaySound = QueueSound;
            game.PlayMusic = QueueMusic;
            game.SaveGame = SaveToStorage;
            game.LoadGame = LoadFromStorage;
            game.StartMusic();
            await host!.InvokeVoidAsync("start");
            status = $"Playing {selected}. Click the game to enable sound and mouse capture.";
        }
        catch (Exception ex) when (ex is IOException or InvalidDataException or ArgumentException or
            InvalidOperationException or HttpRequestException)
        {
            status = $"Cannot load WAD: {ex.Message}";
            Console.Error.WriteLine(status);
        }
        finally { loading = false; }
    }

    void QueueSound(string name)
    {
        if (muted) return;
        if (!soundCache.TryGetValue(name, out byte[]? bytes))
        {
            short[]? samples = game!.Assets.Sound(name);
            bytes = samples == null ? null : new byte[samples.Length * 2];
            if (samples == null) Console.Error.WriteLine($"Missing sound DS{name}; this effect cannot be played.");
            else for (int i = 0; i < samples.Length; i++)
                System.Buffers.Binary.BinaryPrimitives.WriteInt16LittleEndian(bytes!.AsSpan(i * 2), samples[i]);
            soundCache[name] = bytes;
        }
        if (bytes != null) sounds.Add(bytes);
    }

    void SaveToStorage(string json)
    {
        if (JS is IJSInProcessRuntime sync) sync.InvokeVoid("saveGame", json);
    }

    string? LoadFromStorage() => JS is IJSInProcessRuntime sync ? sync.Invoke<string?>("loadGame") : null;

    void TriggerSave() { inputEvents.Enqueue((Buttons.Save, true)); inputEvents.Enqueue((Buttons.Save, false)); }
    void TriggerLoad() { inputEvents.Enqueue((Buttons.Load, true)); inputEvents.Enqueue((Buttons.Load, false)); }

    async Task RunBenchmark()
    {
        double[] result = await host!.InvokeAsync<double[]>("benchmark", reference, 120);
        status = $"120 software renders: {result[0]:F1} ms (checksum {(int)result[1]}). Reload to benchmark the initial scene.";
    }

    [JSInvokable]
    public int Benchmark(int frames)
    {
        if (benchmarkGame == null || frames < 1 || frames > 1000) throw new ArgumentOutOfRangeException(nameof(frames));
        int checksum = 0;
        for (int i = 0; i < frames; i++)
        {
            benchmarkRenderer.Render(benchmarkGame);
            checksum = unchecked(checksum * 31 + benchmarkRenderer.Pixels[(i * 7919) % benchmarkRenderer.Pixels.Length]);
        }
        return checksum;
    }

    void QueueMusic(string? name)
    {
        musicLumpName = name;
        musicChanged = true;
    }

    void ToggleMute(ChangeEventArgs e)
    {
        muted = e.Value is bool value && value;
        if (muted) { sounds.Clear(); musicChanged = false; _ = host?.InvokeVoidAsync("stopMusic"); }
        else if (musicLumpName != null) musicChanged = true; // resend so host.js redecodes and restarts the track
    }

    byte[]? MusicPcmBytes(string name)
    {
        if (!musicCache.TryGetValue(name, out byte[]? bytes))
        {
            short[]? samples = game!.Assets.Music(name);
            bytes = samples == null ? null : new byte[samples.Length * 2];
            if (samples == null) Console.Error.WriteLine($"Missing or unsupported music {name}; no track will play.");
            else for (int i = 0; i < samples.Length; i++)
                System.Buffers.Binary.BinaryPrimitives.WriteInt16LittleEndian(bytes!.AsSpan(i * 2), samples[i]);
            musicCache[name] = bytes;
        }
        return bytes;
    }

    [JSInvokable]
    public async Task<byte[]> Frame(double milliseconds, double mouseX, bool active)
    {
        if (game != null)
        {
            if (active)
            {
                if (previous >= 0) accumulator += Math.Clamp((milliseconds - previous) / 1000, 0, .25);
                input.MouseX += mouseX;
                while (accumulator >= 1.0 / 35)
                {
                    HashSet<Buttons> changed = [];
                    while (inputEvents.TryPeek(out var next) && changed.Add(next.Button))
                    {
                        inputEvents.Dequeue();
                        input.Set(next.Button, next.Down);
                    }
                    game.Tick(input, 1.0 / 35);
                    accumulator -= 1.0 / 35;
                }
                previous = milliseconds;
            }
            else ResetInput();
            renderer.Render(game);
            for (int i = 0; i < renderer.Pixels.Length; i++)
            {
                int color = renderer.Pixels[i];
                rgba[i * 4] = (byte)(color >> 16);
                rgba[i * 4 + 1] = (byte)(color >> 8);
                rgba[i * 4 + 2] = (byte)color;
                rgba[i * 4 + 3] = 255;
            }
            try
            {
                foreach (byte[] sound in sounds) await host!.InvokeVoidAsync("playSound", sound, DoomSharp.Assets.SoundSampleRate);
                if (musicChanged)
                {
                    musicChanged = false;
                    if (muted || musicLumpName == null) await host!.InvokeVoidAsync("stopMusic");
                    else await host!.InvokeVoidAsync("playMusic", musicLumpName, MusicPcmBytes(musicLumpName), DoomSharp.Assets.SoundSampleRate);
                }
            }
            catch (JSException ex)
            {
                if (audioError != ex.Message)
                {
                    audioError = ex.Message;
                    status = $"Audio failed: {ex.Message.Split('\n')[0]}. Select Mute to continue without effects.";
                    Console.Error.WriteLine(status);
                    StateHasChanged();
                }
            }
            finally { sounds.Clear(); }
        }
        return rgba;
    }

    [JSInvokable]
    public void Key(string code, bool down)
    {
        Buttons button = BrowserInput.FromCode(code);
        if (button != Buttons.None) inputEvents.Enqueue((button, down));
    }

    [JSInvokable]
    public void HostError(string message)
    {
        status = message;
        StateHasChanged();
    }

    [JSInvokable]
    public void ResetInput()
    {
        input.Held = Buttons.None;
        inputEvents.Clear();
        input.MouseX = 0;
        previous = -1;
        accumulator = 0;
    }

    public async ValueTask DisposeAsync()
    {
        if (host != null)
        {
            await host.InvokeVoidAsync("dispose");
            await host.DisposeAsync();
        }
        reference?.Dispose();
    }
}
